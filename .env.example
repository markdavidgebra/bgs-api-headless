APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lms_practice_one
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Production SPAs on subdomains: use .bioglowsolutions.com and secure cookies (see pos/catalog/inventory).
# SESSION_DOMAIN=.bioglowsolutions.com
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax
# Leave empty for local dev. Do not set SESSION_DOMAIN=localhost if you use http://127.0.0.1 — the session cookie will not attach and forms return 419 Page Expired.
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false

# Hosts allowed for Sanctum stateful API (comma-separated). Include every SPA origin (POS, catalog, inventory, localhost ports).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5173,127.0.0.1,127.0.0.1:8000,pos.bioglowsolutions.com,catalog.bioglowsolutions.com,inventory.bioglowsolutions.com

# Optional extra CORS origins (comma-separated full URLs, e.g. https://inventory.example.com)
# CORS_ALLOWED_ORIGINS=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Hostinger email — hPanel → Emails → Connect Apps & Devices. If 587 fails, use PORT=465 + MAIL_SCHEME=smtps.
MAIL_MAILER=failover
MAIL_SCHEME=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=admin@bioglowsolutions.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=admin@bioglowsolutions.com
MAIL_FROM_NAME="${APP_NAME}"

# Link shown in patient approval emails.
PATIENT_PORTAL_URL=https://user.bioglowsolutions.com/login

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
